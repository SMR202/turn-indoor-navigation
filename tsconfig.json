{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noEmit": true
  },
  "include": [
    "packages/**/*.ts",
    "apps/api/**/*.ts",
    "scripts/**/*.ts",
    "tooling/**/*.ts",
    "vitest.config.ts"
  ],
  "extends": "expo/tsconfig.base"
}
