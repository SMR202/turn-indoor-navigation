{
  "name": "turn-indoor-navigation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.3.0 <25",
    "npm": ">=10 <12"
  },
  "scripts": {
    "eval": "tsx scripts/eval.mjs",
    "analyze:ble": "tsx scripts/analyze-ble-traces.mjs",
    "replay:fingerprints": "tsx scripts/replay-fingerprints.mjs",
    "compare:motion": "tsx scripts/compare-motion.mjs",
    "phone:tests": "tsx scripts/phone-tests.mjs",
    "phone:android:install": "node scripts/serve-android-build.mjs",
    "diagnose": "tsx scripts/diagnose-runs.mjs",
    "postinstall": "npm run venue:prepare",
    "venue:prepare": "tsx scripts/prepare-venue.mjs",
    "venue:load": "tsx scripts/prepare-venue.mjs",
    "venue:validate": "tsx scripts/validate-venue.mjs",
    "phone:qr": "tsx scripts/phone-qr.mjs",
    "replay": "tsx scripts/replay.mjs",
    "start": "expo start apps/mobile",
    "mobile": "expo start apps/mobile",
    "web": "expo start apps/mobile --web",
    "export:web": "npm run export:web --workspace @turn/mobile",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @turn/mobile && npm run typecheck --workspace @turn/navigator && npm run typecheck --workspace @turn/console",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:check": "node scripts/check-doc-links.mjs",
    "check": "npm run typecheck && npm test && npm run lint && npm run format:check && npm run docs:check",
    "brand:assets": "tsx scripts/generate-brand-assets.ts",
    "api": "tsx apps/api/src/server.ts",
    "navigator": "expo start apps/navigator --port 8082",
    "navigator:web": "expo start apps/navigator --web --port 8082",
    "console": "npm run dev --workspace @turn/console",
    "build:console": "npm run build --workspace @turn/console",
    "platform": "node scripts/platform.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "qrcode": "1.5.4",
    "sharp": "0.34.4",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.1"
  }
}
